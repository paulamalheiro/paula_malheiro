# ==============================================================================
# VARIÁVEIS DE AMBIENTE - LANDING PAGE PAULA MALHEIRO
# Instância Supabase Self-Hosted (Coolify / Hostinger VPS)
# ==============================================================================

# URL base da sua API do Supabase (ex: https://supabase.seudominio.com ou https://api.seuvps.com)
VITE_SUPABASE_URL="https://seu-supabase-coolify.seudominio.com"

# Chave pública/anon do Supabase (encontrada nas configurações de API do projeto no Coolify)
VITE_SUPABASE_ANON_KEY="sua_chave_anonima_do_supabase"

# Nome do Bucket de Storage no Supabase para upload e leitura pública das imagens
# Valor padrão recomendado: 'images'
VITE_SUPABASE_BUCKET_NAME="images"
